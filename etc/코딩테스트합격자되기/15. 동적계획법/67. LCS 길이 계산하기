package com.javacodingtest;

class Solution {

	public static int solution(String str1, String str2) {
		
		// 두 문자열의 길이를 저장
		int m = str1.length();
		int n = str2.length();
		
		// lcs를 저장할 테이블 초기화
		int[][] dp = new int[m+1][n+1];
		
		// 동적 프로그래밍 통해 lcs 길이 개선
		for (int i = 1; i <= m; i++) {
			for (int j = 1; j <= n; j++) {
				// 현재 비교하는 문자가 같으면 -> +1
				if (str1.charAt(i-1) == str2.charAt(j-1)) {
					dp[i][j] = dp[i-1][j-1] + 1;
				}
				// 현재 비교하는 문자가 같지 않으면 -> 각각 -1한거랑 비교해서 최대값 가져오기
				else {
					dp[i][j] = Math.max(dp[i-1][j], dp[i][j-1]);
				}
			}
		}
		
		return dp[m][n];
	}

