package com.javacodingtest;

import java.util.Arrays;

class Solution {

	public static int solution(int[] nums) {

		int[] dp = new int[nums.length];
		Arrays.fill(dp, 1);

		for (int i = 1; i < nums.length; i++) {
			for (int j = 0; j < i; j++) {
				if (nums[i] > nums[j]) {
					dp[i] = Math.max(dp[i], dp[j] + 1);
				}
			}
		}

		return Arrays.stream(dp).max().getAsInt();
	}

