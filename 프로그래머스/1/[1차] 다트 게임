class Solution {
    public int solution(String dartResult) {
        int answer = 0;
        
        int beforeScore = 0;
        
        for (int i = 0; i < dartResult.length() - 1; i+=2) {
            
            int score = dartResult.charAt(i) - '0';
            if (dartResult.charAt(i+1) == '0') {
                score = 10;
                i++;
            }
            
            // 보너스
            if (dartResult.charAt(i+1) == 'D') {
                score *= score;
            } else if (dartResult.charAt(i+1) == 'T') {
                score *= (score * score);
            }
            
            // 옵션(문자열 체크)
            
            boolean flag = false;
            
            if (i+2 < dartResult.length()) {
                if (dartResult.charAt(i+2) == '*') {
                    score *= 2;
                    answer += beforeScore;
                    flag = true;
                } 
                
                if (dartResult.charAt(i+2) == '#') {
                    score *= (-1);
                    flag = true;
                }
                
                if (flag) {
                    i++;
                }
            }
            
            answer += score;
            beforeScore = score;
        }
        
        return answer;
    }
}
