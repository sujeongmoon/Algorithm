class Solution {
    public String solution(String s) {
        String answer = "";
        boolean flag = true;
        
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            
            if (c == ' ') { 
                flag = true;
                answer += ' ';
                continue;
            }
            
            if (flag) {
                c = Character.toUpperCase(c);
            } else { 
                c = Character.toLowerCase(c);
            }
            flag = !flag;
            answer += c;

        }
        
        
        return answer;
    }
}
